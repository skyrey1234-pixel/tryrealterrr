{
  "name": "Message",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ],
      "default": "sms"
    },
    "direction": {
      "type": "string",
      "enum": [
        "outbound",
        "inbound"
      ],
      "default": "outbound"
    },
    "body": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "body"
  ]
}
            "type": "string"
          },
          "raw_note": {
            "type": "string"
          },
          "liked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disliked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          }
        }
      }
